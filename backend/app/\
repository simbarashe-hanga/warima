from app.engine.onboarding_steps import OnboardingStep
from app.schemas.onboarding import OnboardingResult


class OnboardingEngine:

    @classmethod
    def handle(
        cls,
        db,
        user,
        session,
        message: str,
    ) -> OnboardingResult:

        context = session.context or {}

        step = context.get(
            "step",
            OnboardingStep.WELCOME,
        )

        if step == OnboardingStep.WELCOME:
            return cls._welcome(session)

        if step == OnboardingStep.FIRST_NAME:
            return cls._first_name(
                db,
                user,
                session,
                message,
            )

        if step == OnboardingStep.LAST_NAME:
            return cls._last_name(
                db,
                user,
                session,
                message,
            )

        if step == OnboardingStep.DISPLAY_NAME:
            return cls._display_name(
                db,
                user,
                session,
                message,
            )

        if step == OnboardingStep.LANGUAGE:
            return cls._language(
                db,
                user,
                session,
                message,
            )

        if step == OnboardingStep.EMAIL:
            return cls._email(
                db,
                user,
                session,
                message,
            )

        if step == OnboardingStep.CONFIRM:
            return cls._confirm(
                db,
                user,
                session,
                message,
            )

        return OnboardingResult(
            message="Something went wrong.",
            completed=False,
            next_step=None,
        )
